	--define "_srcrpmdir $(HOME)/pgdg.extrastesting/SRPMS" \
	--define "_rpmdir $(HOME)/pgdg.extrastesting/RPMS/" \
	--define "pgmajorversion 17" --define "pginstdir /usr/pgsql-17" --define "pgpackageversion 17" \
