## PostgreSQL extras build targets

extrasbfsrpmtesting: prep
	rpmbuild --define "_sourcedir ." --define "_specdir ." \
	--define "_builddir ." --define "_srcrpmdir $(HOME)/pgdg.extrastesting/SRPMS" \
	--define "_buildrootdir $(HOME)/pgdg.extrastesting/BUILDROOT" \
	--define "pgmajorversion 17" --define "pginstdir /usr/pgsql-17" --define "pgpackageversion 17" \
	--define "_rpmdir ." --nodeps -bs $(SPECFILE)

extrasbuildtesting: prep
	rpmbuild --define "_sourcedir $(PWD)" \
	--define "_specdir $(PWD)" \
	--define "_buildrootdir $(HOME)/pgdg.extrastesting/BUILDROOT" \
	--define "_builddir $(HOME)/pgdg.extrastesting/BUILD" \
	--define "_srcrpmdir $(HOME)/pgdg.extrastesting/SRPMS" \
	--define "_rpmdir $(HOME)/pgdg.extrastesting/RPMS/" \
	--define "pgmajorversion 17" --define "pginstdir /usr/pgsql-17" --define "pgpackageversion 17" \
	-bb $(SPECFILE)
	make extrasbfsrpmtesting

extrasrpmtesting: prep
	rpmbuild --define "_sourcedir $(PWD)" \
	--define "_specdir $(PWD)" \
	--define "_builddir $(PWD)" \
	--define "_buildrootdir $(HOME)/pgdg.extrastesting/BUILDROOT" \
	--define "_srcrpmdir $(PWD)" \
	--define "_rpmdir $(PWD)" \
	--define "pgmajorversion 17" --define "pginstdir /usr/pgsql-17" --define "pgpackageversion 17" \
	-bb $(SPECFILE)

