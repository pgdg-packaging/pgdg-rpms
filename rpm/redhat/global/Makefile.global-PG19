	rpmbuild --define "_sourcedir $(PWD)" \
	--define "_specdir $(PWD)" \
	--define "_builddir $(HOME)/rpm19/BUILD" \
	--define "_buildrootdir $(HOME)/rpm19/BUILDROOT" \
