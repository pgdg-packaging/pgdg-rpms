	--define "_rpmdir ." --nodeps -bs $(SPECFILE)

	rpmbuild --define "_sourcedir $(PWD)" \
	--define "_specdir $(PWD)" \
	--define "_builddir $(HOME)/rpm19/BUILD" \
	--define "_buildrootdir $(HOME)/rpm19/BUILDROOT" \
	--define "_srcrpmdir $(HOME)/rpm19/SRPMS" \
	--define "_rpmdir $(HOME)/rpm19/RPMS/" \
	--define "pgmajorversion 19" --define "pginstdir /usr/pgsql-19" --define "pgpackageversion 19" --define "pgminorversion $(PG19MINORVERSION)" \
	-bb $(SPECFILE)

nopreprpm19:
	rpmbuild --define "_sourcedir $(PWD)" \
	--define "_specdir $(PWD)" \
	--define "_builddir $(PWD)" \
	--define "_buildrootdir $(HOME)/rpm19/BUILDROOT" \
