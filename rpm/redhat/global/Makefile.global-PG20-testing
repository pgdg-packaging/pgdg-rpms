## PostgreSQL 20 Testing

prep20:
	if [ -f dead.package ]; then echo "This package is marked as dead. Build won't continue"; exit 1; fi
	# Update spec file, patches, etc, before running spectool:
	git pull
	# Use spectool to download source files, especially tarballs.
	spectool -g -S --define "_sourcedir $(PWD)" --define "pgmajorversion 20" --define "pginstdir /usr/pgsql-20" --define "pgpackageversion 20" $(SPECFILE)

build20testing: prep20
	rpmbuild --define "_sourcedir $(PWD)" \
	--define "_specdir $(PWD)" \
	--define "_buildrootdir $(HOME)/rpm20testing/BUILDROOT" \
	--define "_builddir $(HOME)/rpm20testing/BUILD" \
	--define "_srcrpmdir $(HOME)/rpm20testing/SRPMS" \
	--define "_rpmdir $(HOME)/rpm20testing/RPMS/" \
	--define "pgmajorversion 20" --define "pginstdir /usr/pgsql-20" --define "pgpackageversion 20" \
	-bb $(SPECFILE)
	make bfsrpm20testing

srpm20testing: prep20
	rpmbuild --define "_sourcedir ." --define "_specdir ." \
	--define "_builddir ." --define "_srcrpmdir ." \
	--define "_buildrootdir $(HOME)/rpm20testing/BUILDROOT" \
	--define "pgmajorversion 20" --define "pginstdir /usr/pgsql-20" --define "pgpackageversion 20" \
	--define "_rpmdir ." --nodeps -bs $(SPECFILE)

