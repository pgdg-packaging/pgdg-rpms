# The PostgreSQL minor releases that the non-common packages are built
# against. They are passed to rpmbuild as the pgminorversion macro, and the
# specs then BuildRequire postgresqlNN-devel and Require postgresqlNN-libs of
# at least that version, so that a package built against a new minor release
# is not installed with an older one. Update them for every minor release,
# after the PostgreSQL packages themselves are built on the build servers.
PG14MINORVERSION = 14.25
PG15MINORVERSION = 15.20
PG16MINORVERSION = 16.16
PG17MINORVERSION = 17.12
PG18MINORVERSION = 18.7
PG19MINORVERSION = 19-rc2

prep:
	if [ -f dead.package ]; then echo "This package is marked as dead. Build won't continue"; exit 1; fi

	# Update spec file, patches, etc, before running spectool:
	git pull

	# Use spectool to download source files, especially tarballs.
	spectool -g -S --define "_sourcedir $(PWD)" $(SPECFILE)

allclean:
	git clean -dfx

clean:
	rm -rf aarch64/ ppc64le/ x86_64/ noarch/
	rm -f *.src.rpm
	rm -f *.tar *.tar.gz *.tar.bz2 *.tgz *.zip .xz

include ../../../../global/Makefile.global-reporpm
include ../../../../global/Makefile.global-reporpm-testing
include ../../../../global/Makefile.global-common
include ../../../../global/Makefile.global-common-testing
include ../../../../global/Makefile.global-extras
include ../../../../global/Makefile.global-extras-testing
include ../../../../global/Makefile.global-PG14-testing
include ../../../../global/Makefile.global-PG14
include ../../../../global/Makefile.global-PG15-testing
include ../../../../global/Makefile.global-PG15
include ../../../../global/Makefile.global-PG16-testing
include ../../../../global/Makefile.global-PG16
include ../../../../global/Makefile.global-PG17-testing
include ../../../../global/Makefile.global-PG17
include ../../../../global/Makefile.global-PG18-testing
include ../../../../global/Makefile.global-PG18
include ../../../../global/Makefile.global-PG19-testing
include ../../../../global/Makefile.global-PG20-testing
