#################################################################################
#   PGDG Red Hat Enterprise Linux / Rocky / AlmaLinux non-free repositories	#
#################################################################################

# $releasever_major and $releasever_minor come from the installed OS release
# (e.g. 9.8), so these repositories follow OS minor version updates. A system
# tied to one minor version with "subscription-manager release --set=9.6" on
# RHEL, or with "9.6" in /etc/dnf/vars/releasever on Rocky Linux / AlmaLinux,
# stays on that minor version. For a single command, use dnf's
# --releasever-minor option. /etc/dnf/vars/releasever_minor is ignored.

# PGDG Red Hat Enterprise Linux / Rocky Linux / AlmaLinux non-free stable repositories:

[pgdg18-nonfree]
name=PostgreSQL 18 for RHEL / Rocky Linux / AlmaLinux $releasever_major.$releasever_minor - $basearch - NonFree
baseurl=https://download.postgresql.org/pub/repos/yum/non-free/18/redhat/rhel-$releasever_major.$releasever_minor-$basearch
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/PGDG-RPM-GPG-KEY-RHEL-nonfree
repo_gpgcheck = 1

[pgdg17-nonfree]
name=PostgreSQL 17 for RHEL / Rocky Linux / AlmaLinux $releasever_major.$releasever_minor - $basearch - NonFree
baseurl=https://download.postgresql.org/pub/repos/yum/non-free/17/redhat/rhel-$releasever_major.$releasever_minor-$basearch
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/PGDG-RPM-GPG-KEY-RHEL-nonfree
repo_gpgcheck = 1

[pgdg16-nonfree]
name=PostgreSQL 16 for RHEL / Rocky Linux / AlmaLinux $releasever_major.$releasever_minor - $basearch - NonFree
baseurl=https://download.postgresql.org/pub/repos/yum/non-free/16/redhat/rhel-$releasever_major.$releasever_minor-$basearch
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/PGDG-RPM-GPG-KEY-RHEL-nonfree
repo_gpgcheck = 1

[pgdg15-nonfree]
name=PostgreSQL 15 for RHEL / Rocky Linux / AlmaLinux $releasever_major.$releasever_minor - $basearch - NonFree
