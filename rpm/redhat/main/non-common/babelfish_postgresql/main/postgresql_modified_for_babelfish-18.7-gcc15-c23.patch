-typedef bool (*called_for_tsql_itvf_func_hook_type)();
+typedef bool (*called_for_tsql_itvf_func_hook_type) (void);
 extern PGDLLIMPORT called_for_tsql_itvf_func_hook_type called_for_tsql_itvf_func_hook;
 
 #endif							/* ATTMAP_H */
