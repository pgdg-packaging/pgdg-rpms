Backport of https://github.com/apache/datasketches-postgresql/pull/78 (merged
after 1.7.0): aod_sketch_union() crashed the backend when the sketches had a
different num_values than the one passed to it. Raise an error instead.

--- src/aod_sketch_c_adapter.cpp
+++ src/aod_sketch_c_adapter.cpp
@@ -157,6 +157,16 @@ char* aod_sketch_to_string(const void* sketchptr, bool print_entries) {
   pg_unreachable();
 }
 
+unsigned aod_sketch_get_num_values(const void* sketchptr) {
+  try {
+    uint8_t num_values = static_cast<const compact_aod_sketch_pg*>(sketchptr)->get_num_values();
+    return num_values;
+  } catch (std::exception& e) {
+    pg_error(e.what());
+  }
+  pg_unreachable();
+}
+
 ptr_with_size aod_sketch_serialize(const void* sketchptr, unsigned header_size) {
   try {
     ptr_with_size p;
