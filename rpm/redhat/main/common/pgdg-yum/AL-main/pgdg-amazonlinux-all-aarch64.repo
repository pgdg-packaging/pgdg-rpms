#########################################################################
# PGDG Amazon Linux 2023 repositories					#
#########################################################################

# PGDG Amazon Linux 2023 stable common repository for all PostgreSQL
# versions

[pgdg-common]
name=PostgreSQL common RPMs for Amazon Linux 2023 - $basearch
baseurl=https://download.postgresql.org/pub/repos/yum/common/amzn/amzn-2023-$basearch
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/PGDG-RPM-GPG-KEY-AARCH64-AMZN
repo_gpgcheck = 1

# We provide extra packages to support some of the RPMs in the PostgreSQL RPM
# repo, like consul, etcd, haproxy, etc.

[pgdg-amzn2023-extras]
name=Extra packages to support some RPMs in the PostgreSQL RPM repo for Amazon Linux 2023 - $basearch
baseurl=https://download.postgresql.org/pub/repos/yum/extras/amzn/amzn-2023-$basearch
enabled=0
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/PGDG-RPM-GPG-KEY-AARCH64-AMZN
repo_gpgcheck = 1

[pgdg-amzn2023-extras-testing]
name=Extra packages to support some RPMs in the PostgreSQL RPM repo for Amazon Linux 2023 - $basearch - Updates testing
baseurl=https://download.postgresql.org/pub/repos/yum/testing/extras/amzn/amzn-2023-$basearch
enabled=0
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/PGDG-RPM-GPG-KEY-AARCH64-AMZN
repo_gpgcheck = 1

